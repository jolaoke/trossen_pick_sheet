<!-- Paper model: flexcomp grid (A4, 5 g) + mujoco.elasticity.shell for bending stiffness
     (Young's modulus 4 GPa, thickness 0.1 mm, Poisson 0.3), friction 0.4.
     If the sheet jitters or explodes, lower 'young' (e.g. 1e9) or the timestep. -->
<!-- Update: arm meshes collide with the paper; paper self-collision off (it made the sheet unstable); same damping as before and
     slightly lower bending stiffness so it drapes/folds instead of springing back. -->
<!-- Update: bending stiffness raised 10x (young 2e10) so the coarse sheet holds its shape like paper.
     Tune: higher young = stiffer (cardstock), lower = floppier. -->
<mujoco model="paper_test">
  <option timestep="0.001" integrator="implicitfast" solver="CG" iterations="50" tolerance="1e-6" />
  <extension>
    <plugin plugin="mujoco.elasticity.shell" />
  </extension>
  <visual>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.6 0.6 0.6" />
  </visual>
  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1=".2 .3 .4" rgb2=".1 .2 .3" width="512" height="512" />
    <material name="grid" texture="grid" texrepeat="4 4" />
  </asset>
  <worldbody>
    <light pos="0 0 2" dir="0 0 -1" />
    <geom name="floor" type="plane" size="1 1 0.1" material="grid" />
    <body name="table" pos="0 0 0.2">
      <geom name="table_top" type="box" size="0.4 0.3 0.2" rgba="0.6 0.45 0.3 0.4" contype="1" conaffinity="1" />
    </body>
    <flexcomp name="paper" type="grid" dim="2" count="22 30 1" spacing="0.01 0.01 0.01" pos="0 0 0.41" radius="0.002" mass="0.005" rgba="1 1 1 1">
      <edge equality="true" damping="0.001" />
      <contact condim="3" friction="0.4" selfcollide="none" internal="false" contype="1" conaffinity="3" priority="1" solref="0.004 1" solimp="0.95 0.99 0.001" margin="0.001" />
      <plugin plugin="mujoco.elasticity.shell">
        <config key="young" value="2e10" />
        <config key="poisson" value="0.3" />
        <config key="thickness" value="1e-4" />
      </plugin>
    </flexcomp>
  </worldbody>
</mujoco>
